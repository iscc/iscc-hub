# ISCC-HUB Configuration

################################################################################################################
# Development Mode Auto-Detection                                                                              #
################################################################################################################
# The application automatically detects development mode when the tests/ directory exists.
# In development mode, the following secure defaults are used (no .env file needed):
#
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=test-secret-key-for-testing-only
# ISCC_HUB_DOMAIN=localhost
# ISCC_HUB_SECKEY=z3u2RDonZ81AFKiw8QCPKcsyg8Yy2MmYQNxfBn51SS2QmMiw
# ISCC_HUB_ID=0
# ISCC_HUB_DB_NAME=iscc-hub-dev.db
# ISCC_HUB_REALM=0

################################################################################################################
# Production Settings (all required)                                                                           #
################################################################################################################

# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=your-production-secret-key-here
# ISCC_HUB_DOMAIN=hub.example.com
# ISCC_HUB_SECKEY=your-production-ed25519-secret-key-multibase
# ISCC_HUB_ID=1234
# ISCC_HUB_REALM=1

################################################################################################################
# Optional Settings                                                                                             #
################################################################################################################

# Background scheduler intervals in seconds (0 disables; defaults shown). The checkpoint
# also rebuilds lazily on read, so disabling it is safe.
# ISCC_HUB_HUB_SYNC_INTERVAL=3600
# ISCC_HUB_CHECKPOINT_INTERVAL=86400

# Declaration policy (set-once server policy, read on every declaration; changing requires a restart)
# ISCC_HUB_OPEN_ACCESS=true                  # false = permissioned mode (only registered pubkeys may declare)
# ISCC_HUB_REQUIRE_CLIENT_TIMESTAMP=false    # true = reject declarations without a client-supplied timestamp
# ISCC_HUB_TIMESTAMP_TOLERANCE_SECONDS=600   # Max deviation (s) for a provided timestamp; <=0 disables the check

# Identity & unit acceptance policies. All three default to ON. They are BREAKING for declarers
# that do not yet emit a did:web controller and 256-bit units — flip them off until the tooling complies.
# ISCC_HUB_REQUIRE_DID=true                  # A: reject unless signature.controller is a did:web URI (no network)
# ISCC_HUB_VERIFY_DID=true                   # B: resolve the controller's did.json and require it to authorize
#                                            #    the signing key. STRICT FAIL-CLOSED: a missing controller,
#                                            #    an unresolvable host, or a doc that does not list the key all
#                                            #    reject (did_required/did_unauthorized -> 422; did_unresolvable
#                                            #    -> 503 + Retry-After). One outbound HTTPS request per uncached
#                                            #    controller; the fetch is SSRF-guarded (only globally-routable
#                                            #    hosts are reached). Needs the controller's DID hosting to be live.
# ISCC_HUB_REQUIRE_FULL_UNITS=true           # C: require a 256-bit body for every provided ISCC-UNIT
# ISCC_HUB_DID_CACHE_TTL=3600                # B positive-cache TTL (s); per-worker LocMemCache, positive results only

# Similarity search proxy. Defaults to search.iscc.io; set ISCC_HUB_SEARCH_URLS empty to disable (/search returns 404)
# ISCC_HUB_SEARCH_URLS=https://search.iscc.io        # Default; ordered, comma-separated backend base URLs (failover order)
# ISCC_HUB_SEARCH_INDEX=idptest                      # Backend index name; defaults from ISCC_HUB_REALM (0=idptest, 1=idp)
# ISCC_HUB_SEARCH_TIMEOUT=1.5                        # Per-backend connect+read timeout in seconds
# ISCC_HUB_SEARCH_MAX_INFLIGHT=24                    # Concurrent proxied searches per process; over it -> 503
# ISCC_HUB_SEARCH_API_KEY=                           # Sent as X-API-Key header when set
# ISCC_HUB_SEARCH_CB_FAILS=5                         # Circuit breaker opens after N consecutive failures
# ISCC_HUB_SEARCH_CB_COOLDOWN=15                     # Circuit breaker cooldown in seconds

# ISCC generator backend (iscc-web). When set, the homepage uploads a dropped file to this service
# to generate a full ISCC-CODE (incl. Semantic-Code) and runs similarity search on it. Empty
# disables generation: the homepage falls back to a local-only Instance-Code + exact datahash
# lookup and the file never leaves the browser.
# PRIVACY: this is DEFAULT-ON. With the default value below, every file dropped on the homepage is
# uploaded to the third-party service at web.iscc.io. Set it empty to keep file-drop fully local.
# ISCC_HUB_GENERATOR_URL=https://web.iscc.io         # Default; set empty to disable full-code generation

# Optional co-branding (rendered into HTML pages only; changing requires a restart)
# ISCC_HUB_ORG_NAME=Example University       # Set to enable the co-branding card and footer
# ISCC_HUB_ORG_LOGO=https://example.com/logo.svg   # Full URL or path to a static/mounted file (not an upload)
# ISCC_HUB_ORG_URL=https://example.com
# ISCC_HUB_ORG_TAGLINE=Digital Archives at Example University
# ISCC_HUB_CTA_ENABLED=false                 # true = show the call-to-action section
# ISCC_HUB_CTA_TITLE=Integrate with Our Services
# ISCC_HUB_CTA_DESCRIPTION=Connect your systems to our content registry.
# ISCC_HUB_CTA_BUTTON_TEXT=Explore Our Repository
# ISCC_HUB_CTA_BUTTON_URL=https://example.com/repository

################################################################################################################
# Sandbox deploy (sb0.iscc.id) — consumed by compose.sandbox.yaml                                              #
################################################################################################################
# compose.sandbox.yaml interpolates the three SECRETS below from a root-only /opt/iscc-hub/.env on
# the box (never committed). All other sandbox settings are inline in compose.sandbox.yaml.
#
# DJANGO_SECRET_KEY=your-sandbox-django-secret
# ISCC_HUB_SECKEY=your-sandbox-ed25519-secret-key-multibase   # the sandbox hub identity (z3u2...)
# ISCC_HUB_ADMIN_PWD=your-sandbox-admin-password
