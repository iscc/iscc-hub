# ISCC-HUB configuration
#
# Copy this file to `.env`, fill in the required values and give it to the container, for example with
# `env_file: .env` in compose.yaml or `docker run --env-file .env`. Never commit your `.env` file.
# The hub reads these variables at start. Restart the container to apply a change.
#
# Guide: https://hub.iscc.codes/run-a-hub/  Reference: https://hub.iscc.codes/configuration/
#
# Write each comment on its own line. `docker run --env-file` reads a comment after a value as part of the
# value, so `ISCC_HUB_REQUIRE_DID=true  # note` would turn the policy off.
#
# An empty value is not the same as an unset variable. Leave the lines that you do not use commented out.

########################################################################################################################
# Required
########################################################################################################################
# The hub does not start if one of these is missing, or if ISCC_HUB_SECKEY is not a valid key.
# ISCC_HUB_ID, ISCC_HUB_REALM, ISCC_HUB_SECKEY and ISCC_HUB_DOMAIN are fixed for the life of the hub. Each ISCC-ID
# contains the hub ID and the realm. The key and the domain verify all receipts and checkpoints.

DJANGO_DEBUG=false

# A long random string. Make it with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Public host name of the hub. It sets the did:web identity of the hub.
ISCC_HUB_DOMAIN=hub.example.com

# secret_key from `uvx iscc-crypto keygen` (z3u2...). Keep a copy offline: a database backup is useless without it.
ISCC_HUB_SECKEY=

# 0 to 4095. Select the next free hub ID (the highest hub ID plus 1) in hubs/testnet.yaml or hubs/mainnet.yaml.
ISCC_HUB_ID=

# 0 = testnet, 1 = mainnet
ISCC_HUB_REALM=0

########################################################################################################################
# Admin user
########################################################################################################################
# If set, the hub creates the user `admin` with this password at start, if the user does not exist.
# Changing the value later does not change the password.
# ISCC_HUB_ADMIN_PWD=

########################################################################################################################
# Web and proxy
########################################################################################################################
# Host names that the hub accepts, comma-separated. The default is ISCC_HUB_DOMAIN. If you set it, the value
# replaces the default, so include the domain.
# DJANGO_ALLOWED_HOSTS=hub.example.com

# Origins with scheme for admin forms, comma-separated. The default is https:// + ISCC_HUB_DOMAIN.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hub.example.com

########################################################################################################################
# Database
########################################################################################################################
# With SQLite, all state is in /app/data. Mount it on a persistent volume on a local disk (not NFS, SMB or a cloud
# file share). ISCC_HUB_DB_ENGINE, ISCC_HUB_DB_NAME and the /app/data volume are fixed after the first start:
# if you change one of them, the hub starts an empty log under the same identity.

# FULL or NORMAL (default). Use FULL. With NORMAL, a power loss or an operating system crash can roll back
# declarations that the hub already confirmed, and the hub then gives their log positions to new declarations.
ISCC_HUB_SQLITE_SYNC_MODE=FULL

# SQLite file name in /app/data. The default contains the hub ID with 4 digits, for example iscc-hub-0042.db.
# ISCC_HUB_DB_NAME=iscc-hub-0042.db

# sqlite (default) or postgres (tested with PostgreSQL 16). For PostgreSQL, also set the variables below and make
# the database user the owner of the database.
# ISCC_HUB_DB_ENGINE=sqlite
# ISCC_HUB_DB_HOST=localhost
# ISCC_HUB_DB_PORT=5432
# ISCC_HUB_DB_USER=postgres
# ISCC_HUB_DB_PASSWORD=
# ISCC_HUB_DB_NAME_PG=iscc_hub

# TLS to the database server. These are standard PostgreSQL variables; the database driver reads them.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/path/to/ca.pem

########################################################################################################################
# Acceptance policies
########################################################################################################################
# These policies make the hub reject declarations that the protocol permits. Permissioned mode is off by default.
# All other policies are on by default.

# DID controller required: the signature must name a did:web controller.
# ISCC_HUB_REQUIRE_DID=true

# DID verification: the DID document of the controller must list the signing key. The hub fetches
# https://<controller domain>/.well-known/did.json, from public IP addresses only. If it cannot get the document,
# it rejects the declaration with 503 and Retry-After. The hub needs outbound HTTPS to any public host for this.
# ISCC_HUB_VERIFY_DID=true

# Full ISCC-UNITs: the declaration must include its ISCC-UNITs. Provided units must always be 256-bit.
# ISCC_HUB_REQUIRE_FULL_UNITS=true

# Seconds that each worker keeps a successful DID check.
# ISCC_HUB_DID_CACHE_TTL=3600

# Permissioned mode: false = only public keys that you add in the admin interface (Public Keys) can declare.
# ISCC_HUB_OPEN_ACCESS=true

########################################################################################################################
# Declaration rules
########################################################################################################################
# true = reject declarations without a timestamp.
# ISCC_HUB_REQUIRE_CLIENT_TIMESTAMP=false

# Maximum difference in seconds between a given timestamp and the hub clock. 0 turns the check off.
# ISCC_HUB_TIMESTAMP_TOLERANCE_SECONDS=600

########################################################################################################################
# Similarity search
########################################################################################################################
# /search sends queries to an iscc-search server. Set ISCC_HUB_SEARCH_URLS empty to turn /search off (404).

# Server URLs, comma-separated, tried in this order.
# ISCC_HUB_SEARCH_URLS=https://search.iscc.io

# Index name. The default is idptest for realm 0 and idp for realm 1.
# ISCC_HUB_SEARCH_INDEX=idptest

# Sent as X-API-Key header.
# ISCC_HUB_SEARCH_API_KEY=

# Seconds for each server.
# ISCC_HUB_SEARCH_TIMEOUT=1.5

# Searches at the same time in each worker process; more get 503. Only matters with THREADS greater than 1.
# ISCC_HUB_SEARCH_MAX_INFLIGHT=24

# Failures in sequence before the hub stops using a server, and seconds before it tries that server again.
# ISCC_HUB_SEARCH_CB_FAILS=5
# ISCC_HUB_SEARCH_CB_COOLDOWN=15

# Sort results again so that matches with more evidence come first, and how many results to get for that.
# ISCC_HUB_SEARCH_RERANK=true
# ISCC_HUB_SEARCH_RERANK_WINDOW=100

# Start value of the score filter on the home page. The API returns all results.
# ISCC_HUB_SEARCH_MIN_SCORE=0.70

########################################################################################################################
# Home page
########################################################################################################################
# PRIVACY: with the default, the home page uploads each dropped file to web.iscc.io to generate a full ISCC-CODE.
# Set it empty to keep files in the browser (Instance-Code and exact lookup only).
# ISCC_HUB_GENERATOR_URL=https://web.iscc.io

# Co-branding on HTML pages. Set ISCC_HUB_ORG_NAME to show the organization card and footer.
# ISCC_HUB_ORG_NAME=Example University
# ISCC_HUB_ORG_URL=https://example.com
# ISCC_HUB_ORG_TAGLINE=Digital Archives at Example University

# URL of the logo. To serve your own file, mount it read-only to /app/iscc_hub/static/media/logo.svg and set
# /media/logo.svg. That path is outside /app/data, so keep a copy of the file.
# ISCC_HUB_ORG_LOGO=/media/logo.svg

# true = show a call-to-action section with these texts and link.
# ISCC_HUB_CTA_ENABLED=false
# ISCC_HUB_CTA_TITLE=
# ISCC_HUB_CTA_DESCRIPTION=
# ISCC_HUB_CTA_BUTTON_TEXT=
# ISCC_HUB_CTA_BUTTON_URL=

########################################################################################################################
# Background jobs
########################################################################################################################
# Download the hub list from GitHub (raw.githubusercontent.com) at start. A failed download does not stop the hub.
# ISCC_HUB_LIST_INITIAL_SYNC=true

# Seconds between hub list downloads. 0 turns the job off.
# ISCC_HUB_HUB_SYNC_INTERVAL=3600

# Seconds between checkpoint updates. 0 turns the job off. The hub also updates the checkpoint when a client reads it.
# ISCC_HUB_CHECKPOINT_INTERVAL=86400

########################################################################################################################
# Web server (Gunicorn with sync workers)
########################################################################################################################
# The hub writes declarations one at a time, so more workers give more read capacity, not more write capacity.
# The hub uses about 500 MB of memory with 4 workers. On a server with 1 GB, set WORKERS=2.
# PORT=8000
# WORKERS=4
# THREADS=1
# TIMEOUT=30

# Seconds that workers get to finish requests at shutdown. Give the container more time to stop than this,
# for example `stop_grace_period: 45s` in compose.yaml or `docker run --stop-timeout 45`.
# GRACEFUL_TIMEOUT=30

# Seconds to keep a connection open. Gunicorn uses it only with THREADS greater than 1.
# KEEP_ALIVE=5

# Requests before a worker restarts, plus a random addition. 0 turns the restart off.
# MAX_REQUESTS=1000
# MAX_REQUESTS_JITTER=50

# LOG_LEVEL=info

# Do not set ENVIRONMENT=development with the published image. That mode needs tools that the image does not have.

########################################################################################################################
# Local development
########################################################################################################################
# A source checkout with the tests/ directory runs in development mode and needs no .env file. It then uses
# INSECURE defaults: DJANGO_DEBUG=true, a fixed test DJANGO_SECRET_KEY and ISCC_HUB_SECKEY, ISCC_HUB_DOMAIN=localhost,
# ISCC_HUB_ID=1, ISCC_HUB_REALM=0 and ISCC_HUB_DB_NAME=iscc-hub-dev.db. Never use them in production.
